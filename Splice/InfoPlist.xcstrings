{
  "sourceLanguage": "ja",
  "version": "1.0",
  "strings": {
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行中の写真・動画を読み込んでムービーを作るために使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to load your photos and videos to make movies."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出したムービーを写真ライブラリに保存するために使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to save exported movies to your Photos library."
          }
        }
      }
    }
  }
}